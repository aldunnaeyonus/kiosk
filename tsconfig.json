{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "strict": true,
    "jsx": "react",
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "typeRoots": [
    "../node_modules/@types",
    "../@types"
  ],
  "include": ["Data/**/*"],
  "exclude": ["node_modules"]
}
